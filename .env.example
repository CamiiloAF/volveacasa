# --- Supabase -----------------------------------------------------------
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Salta RLS: solo se usa en el servidor. NUNCA la pongas en una variable NEXT_PUBLIC_.
# No hace falta la anon key: la tabla niega todo por RLS y la app entra siempre
# desde el servidor, para que nadie pueda descargarse los teléfonos en bloque.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Gemini -------------------------------------------------------------
# aistudio.google.com/apikey → Create API key. Tiene capa gratuita.
# Si falta, la app sigue funcionando: publicar no extrae atributos y la
# búsqueda cae al modo por palabras sueltas.
GEMINI_API_KEY=AIza...

# Opcional. Por defecto: gemini-3.1-flash-lite, el más barato de los que
# siguen disponibles en la capa gratuita ($0.25/$1.50 por millón de tokens).
# Medido contra la API real con una foto de verdad: acierta igual que los
# modelos más caros describiendo una mascota y cruzando avisos.
# Con facturación activa podés subir de modelo acá, sin tocar código:
# GEMINI_MODEL=gemini-3.6-flash

# Opcional. Cuánto esperamos al modelo antes de publicar igual sin análisis.
# Vercel corta la función a los 60s; dejamos margen a propósito.
# GEMINI_TIMEOUT_MS=40000

# --- Sitio --------------------------------------------------------------
# Necesaria para que las previsualizaciones de WhatsApp y Facebook resuelvan
# bien las URLs absolutas. En Vercel poné el dominio final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
