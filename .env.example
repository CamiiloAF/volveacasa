# --- Supabase -----------------------------------------------------------
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Salta RLS: solo se usa en el servidor. NUNCA la pongas en una variable NEXT_PUBLIC_.
# No hace falta la anon key: la tabla niega todo por RLS y la app entra siempre
# desde el servidor, para que nadie pueda descargarse los teléfonos en bloque.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Claude -------------------------------------------------------------
# console.anthropic.com → API Keys
# Si falta, la app sigue funcionando: publicar no extrae atributos y la
# búsqueda cae al modo por palabras sueltas.
ANTHROPIC_API_KEY=sk-ant-...

# --- Sitio --------------------------------------------------------------
# Necesaria para que las previsualizaciones de WhatsApp y Facebook resuelvan
# bien las URLs absolutas. En Vercel poné el dominio final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
